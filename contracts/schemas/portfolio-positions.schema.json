{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-positions.schema.json",
  "title": "PortfolioPositions",
  "description": "bot-engine GET /api/v1/portfolio/positions response. quantity is negative for a short position.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["symbol", "quantity", "average_entry_price", "current_price", "unrealized_pnl"],
    "additionalProperties": false,
    "properties": {
      "symbol": {"type": "string", "minLength": 1},
      "quantity": {"type": "number"},
      "average_entry_price": {"type": "number"},
      "current_price": {"type": "number"},
      "unrealized_pnl": {"type": "number"}
    }
  }
}
