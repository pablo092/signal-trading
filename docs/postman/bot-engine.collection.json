{
  "info": {
    "_postman_id": "a1b2c3d4-0002-0002-0002-000000000002",
    "name": "Bot Engine",
    "description": "Order execution and portfolio management API.\n\n**Base URL**: `{{bot_engine_url}}`\n**WebSocket**: `{{bot_engine_ws_url}}`\n\n## Setup\n1. Import this collection\n2. Create environment `Trading Bot - Local` with:\n   - `bot_engine_url = http://localhost:8080`\n   - `bot_engine_ws_url = ws://localhost:8080/ws`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "bot_engine_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "bot_engine_ws_url",
      "value": "ws://localhost:8080/ws",
      "type": "string"
    },
    {
      "key": "bot_engine_token",
      "value": ""
    },
    {
      "key": "intent_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness probe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{bot_engine_url}}/health/live",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"status\":\"alive\"}"
            }
          ]
        },
        {
          "name": "Readiness probe",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{bot_engine_url}}/health/ready",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"status\":\"ready\",\"service\":\"bot-engine\",\"ws_clients\":2,\"paper_mode\":true}"
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Order intents",
      "description": "M3/M4 order flow (docs/runbooks/ORDER_INTENTS.md). Propose with an intent:create token; approve or reject with a human intent:approve token. Approval also needs ORDER_EXECUTION_ENABLED=true.",
      "item": [
        {
          "name": "Propose intent — AAPL RSI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"symbol\":\"AAPL\",\"strategy\":\"rsi\"}"
            },
            "description": "Returns 201 pending_approval, or rejected with risk.checks. Save the id into intent_id."
          }
        },
        {
          "name": "Propose intent — missing Idempotency-Key (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"symbol\":\"AAPL\",\"strategy\":\"rsi\"}"
            }
          }
        },
        {
          "name": "List pending intents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents?status=pending_approval&limit=50",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents?status=pending_approval&limit=50"
              ]
            }
          }
        },
        {
          "name": "Get intent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents/{{intent_id}}",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents",
                "{{intent_id}}"
              ]
            }
          }
        },
        {
          "name": "Approve intent (human)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents/{{intent_id}}/approve",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents",
                "{{intent_id}}",
                "approve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"checked the chart\"}"
            }
          }
        },
        {
          "name": "Reject intent (human)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents/{{intent_id}}/reject",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents",
                "{{intent_id}}",
                "reject"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"not today\"}"
            }
          }
        },
        {
          "name": "Cancel own intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/order-intents/{{intent_id}}/cancel",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "order-intents",
                "{{intent_id}}",
                "cancel"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Get portfolio equity",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/portfolio/equity",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "portfolio",
                "equity"
              ]
            },
            "description": "Returns current account equity, paper mode flag, and market status."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"equity\":100000.00,\"paper_mode\":true,\"market_open\":true}"
            }
          ]
        },
        {
          "name": "Get open positions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/portfolio/positions",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "portfolio",
                "positions"
              ]
            },
            "description": "Returns all currently open positions with unrealized P&L."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"symbol\": \"AAPL\",\n    \"quantity\": 3.33,\n    \"average_entry_price\": 182.50,\n    \"current_price\": 184.20,\n    \"unrealized_pnl\": 5.66\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get kill switch",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/admin/kill-switch",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "kill-switch"
              ]
            }
          }
        },
        {
          "name": "Engage kill switch (human admin:killswitch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bot_engine_url}}/api/v1/admin/kill-switch",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "kill-switch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"engaged\":true,\"reason\":\"incident\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Observability",
      "item": [
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{bot_engine_url}}/metrics",
              "host": [
                "{{bot_engine_url}}"
              ],
              "path": [
                "metrics"
              ]
            }
          }
        }
      ],
      "auth": {
        "type": "noauth"
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bot_engine_token}}",
        "type": "string"
      }
    ]
  }
}
