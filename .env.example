# ════════════════════════════════════════════════════════════════
# Signal Trading — environment for `docker compose` (copy to .env).
# NEVER commit .env. Values here are placeholders, not working credentials.
# ════════════════════════════════════════════════════════════════

# ── Alpaca Markets: PAPER account only (required) ───────────────
# https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex            # iex (free) or sip (paid)

# ── Runtime ─────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Service auth (ADR-003) — see docs/runbooks/SERVICE_TOKENS.md ─
# JSON token table with sha256 digests, shared by both services.
# Empty = every /api/v1/* call returns 401.
SERVICE_AUTH_TOKENS=
# Plaintext token bot-engine uses to call signal-service (market:read).
BOT_ENGINE_SIGNAL_TOKEN=

# ── Execution safety (ADR-005) ──────────────────────────────────
# Keep false. true only re-enables the legacy paper order route.
ORDER_EXECUTION_ENABLED=false

# ── Optional infra: `docker compose --profile full up` ─────────
# No defaults: each container refuses to start with an empty value.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASS=
GRAFANA_USER=
GRAFANA_PASSWORD=
